{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(podman-compose:*)",
      "Bash(podman:*)",
      "Bash(scripts/ruff.sh:*)",
      "Bash(scripts/export_diagram.sh:*)",
      "Bash(.setup/scripts/*)",
      "Bash(openspec:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": ["Bash(git push:*)", "Bash(git remote:*)"]
  }
}
